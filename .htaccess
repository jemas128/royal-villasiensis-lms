<IfModule mod_rewrite.c>
    RewriteEngine On

    # Security Headers
    <IfModule mod_headers.c>
        Header always set X-Frame-Options "SAMEORIGIN"
        Header always set X-Content-Type-Options "nosniff"
        Header always set Referrer-Policy "strict-origin-when-cross-origin"
    </IfModule>

    # Prevent missing static assets from booting Laravel and exhausting PHP processes
    RewriteCond %{REQUEST_URI} \.(css|js|png|jpe?g|gif|ico|svg|webp|woff2?|ttf|eot|map)$ [NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ - [R=404,L]

    # Forward web requests to public/ without infinite loops
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

